      "lines": [
        "# MAPLE: Manifold-Activated Pruning of Latent Experts",
        "def prune_moe_layer(experts, activation_manifold, target_bpw=1.48):",
        "    scores = compute_manifold_salience(experts, activation_manifold)",
        "    keep_mask = scores >= torch.quantile(scores, 1.0 - target_bpw / 4.0)",
        "    # Gemma 4 26B: 9.92 GB -> 4.75 GB (45.4 tok/s on 6GB VRAM)",
        "    return pack_gguf_sub2bpw(experts[keep_mask])"
      ]
